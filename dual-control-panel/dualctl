#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.1.0"
BRANCH="agent/dual-control-panel"
REPO="aliiitavazoeiii-afk/backhaul-ha-installer"
RAW="https://raw.githubusercontent.com/${REPO}/${BRANCH}"
ENGINE_RAW="${RAW}/dual-foreign-active-active"
STATE_DIR="/etc/dual-control-panel"
STATE_FILE="${STATE_DIR}/state.env"
BACKUP_DIR="/root/dual-backhaul-backups"
HAPROXY_CFG="/etc/haproxy/haproxy.cfg"

c0='\033[0m'; c1='\033[1;36m'; c2='\033[1;32m'; c3='\033[1;33m'; c4='\033[1;31m'; dim='\033[2m'
info(){ echo -e "${c1}[i]${c0} $*"; }
ok(){ echo -e "${c2}[OK]${c0} $*"; }
warn(){ echo -e "${c3}[!]${c0} $*" >&2; }
die(){ echo -e "${c4}[x]${c0} $*" >&2; exit 1; }
pause(){ echo; read -r -p 'Press Enter to continue...' _; }
need_root(){ [[ ${EUID:-$(id -u)} -eq 0 ]] || die 'Run as root.'; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }

load_state(){
  [[ -f "$STATE_FILE" ]] || return 1
  # shellcheck disable=SC1090
  source "$STATE_FILE"
}

save_state(){
  install -d -m 0700 "$STATE_DIR"
  umask 077
  cat > "$STATE_FILE" <<EOFSTATE
ROLE='${ROLE:-}'
IRAN_IP='${IRAN_IP:-}'
FOREIGN_A_IP='${FOREIGN_A_IP:-}'
FOREIGN_B_IP='${FOREIGN_B_IP:-}'
DOMAIN_A='${DOMAIN_A:-}'
DOMAIN_B='${DOMAIN_B:-}'
WSS_ENABLED='${WSS_ENABLED:-1}'
FOREIGN_ROLE='${FOREIGN_ROLE:-}'
BUNDLE_PATH='${BUNDLE_PATH:-}'
EOFSTATE
  chmod 0600 "$STATE_FILE"
}

valid_ipv4(){
  local ip="$1" IFS=. a o
  read -r -a a <<< "$ip"
  [[ ${#a[@]} -eq 4 ]] || return 1
  for o in "${a[@]}"; do [[ "$o" =~ ^[0-9]{1,3}$ ]] && ((10#$o<=255)) || return 1; done
}
valid_domain(){ [[ "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }
ask_ip(){
  local prompt="$1" default="${2:-}" v
  while :; do
    if [[ -n "$default" ]]; then read -r -p "$prompt [$default]: " v; v="${v:-$default}"; else read -r -p "$prompt: " v; fi
    valid_ipv4 "$v" && { printf '%s' "$v"; return; }
    echo 'Invalid IPv4.' >&2
  done
}
ask_domain(){
  local prompt="$1" v
  while :; do
    read -r -p "$prompt: " v
    valid_domain "$v" && { printf '%s' "$v"; return; }
    echo 'Invalid domain.' >&2
  done
}

header(){
  clear 2>/dev/null || true
  echo -e "${c1}============================================================${c0}"
  echo -e "${c1}   Dual-Foreign Control Panel  v${VERSION}${c0}"
  echo -e "${c1}============================================================${c0}"
  if load_state; then
    if [[ "${ROLE:-}" == iran ]]; then
      echo " Role: IRAN   Iran: ${IRAN_IP:-?}   A: ${FOREIGN_A_IP:-?}   B: ${FOREIGN_B_IP:-?}"
    else
      echo " Role: ${FOREIGN_ROLE:-FOREIGN}   Iran: ${IRAN_IP:-?}"
    fi
  else
    echo ' Not configured yet.'
  fi
  echo
}

fetch_engine(){
  local out="$1"
  curl -fsSL "${ENGINE_RAW}/install-dual.sh" -o "$out"
  bash -n "$out"
}

apply_patches_iran(){
  bash <(curl -fsSL "${ENGINE_RAW}/enable-sticky-users.sh")
  bash <(curl -fsSL "${ENGINE_RAW}/enable-fast-failover.sh")
}

setup_iran(){
  header
  echo 'Initial IRAN setup'
  echo
  local detected tmp
  detected="$(hostname -I 2>/dev/null | awk '{print $1}')"
  IRAN_IP="$(ask_ip 'Iran public IPv4' "$detected")"
  FOREIGN_A_IP="$(ask_ip 'Foreign A IPv4')"
  FOREIGN_B_IP="$(ask_ip 'Foreign B IPv4')"
  [[ "$FOREIGN_A_IP" != "$FOREIGN_B_IP" ]] || die 'Foreign A and B must be different.'

  echo
  echo 'WSSMux is the recommended primary transport and requires two domains pointing to the Iran IP.'
  read -r -p 'Enable WSSMux primary? [Y/n]: ' ans
  if [[ "${ans:-Y}" =~ ^[Nn]$ ]]; then
    warn 'The current stable data-plane engine requires WSS domains. MUX/TCP-only setup is not enabled in this first panel build.'
    warn 'Choose WSS now; a no-domain profile can be added after the panel itself is validated.'
    return 1
  fi
  WSS_ENABLED=1
  DOMAIN_A="$(ask_domain 'Domain for Foreign A WSS (must resolve to Iran)')"
  DOMAIN_B="$(ask_domain 'Domain for Foreign B WSS (must resolve to Iran)')"
  [[ "$DOMAIN_A" != "$DOMAIN_B" ]] || die 'Domains must be different.'

  tmp="$(mktemp)"
  fetch_engine "$tmp"
  echo
  info 'Installing the validated Dual data-plane engine...'
  bash "$tmp" --role iran --iran-ip "$IRAN_IP" --foreign-a-ip "$FOREIGN_A_IP" --foreign-b-ip "$FOREIGN_B_IP" --domain-a "$DOMAIN_A" --domain-b "$DOMAIN_B" --replace-existing-tunnel
  apply_patches_iran
  rm -f "$tmp"
  ROLE=iran; FOREIGN_ROLE=''; BUNDLE_PATH=''
  save_state
  ok 'Iran setup complete.'
  echo
  echo 'Bundles created:'
  echo '  /root/dual-backhaul-foreign-a.env'
  echo '  /root/dual-backhaul-foreign-b.env'
  echo
  echo 'Next: copy each bundle to its Foreign and run the same one-line panel installer there.'
}

setup_foreign(){
  local fr="$1" default_bundle tmp expected
  header
  [[ "$fr" == a ]] && { FOREIGN_ROLE=foreign-a; default_bundle=/root/dual-backhaul-foreign-a.env; } || { FOREIGN_ROLE=foreign-b; default_bundle=/root/dual-backhaul-foreign-b.env; }
  echo "Initial ${FOREIGN_ROLE} setup"
  echo
  read -r -p "Bundle path [$default_bundle]: " BUNDLE_PATH
  BUNDLE_PATH="${BUNDLE_PATH:-$default_bundle}"
  [[ -f "$BUNDLE_PATH" ]] || die "Bundle not found: $BUNDLE_PATH"
  chmod 0600 "$BUNDLE_PATH"
  expected="$(sed -n "s/^ROLE='\([^']*\)'$/\1/p" "$BUNDLE_PATH" | head -n1)"
  [[ "$expected" == "$FOREIGN_ROLE" ]] || die "Bundle role is $expected, expected $FOREIGN_ROLE"
  IRAN_IP="$(sed -n "s/^IRAN_IP='\([^']*\)'$/\1/p" "$BUNDLE_PATH" | head -n1)"
  if [[ "$FOREIGN_ROLE" == foreign-a ]]; then FOREIGN_A_IP="$(sed -n "s/^FOREIGN_IP='\([^']*\)'$/\1/p" "$BUNDLE_PATH" | head -n1)"; FOREIGN_B_IP=''; else FOREIGN_B_IP="$(sed -n "s/^FOREIGN_IP='\([^']*\)'$/\1/p" "$BUNDLE_PATH" | head -n1)"; FOREIGN_A_IP=''; fi
  DOMAIN_A=''; DOMAIN_B=''; WSS_ENABLED=1; ROLE=foreign

  tmp="$(mktemp)"
  fetch_engine "$tmp"
  info "Installing ${FOREIGN_ROLE} data-plane..."
  bash "$tmp" --role "$FOREIGN_ROLE" --bundle "$BUNDLE_PATH" --replace-existing-tunnel
  bash <(curl -fsSL "${ENGINE_RAW}/enable-xray-aware-health.sh")
  rm -f "$tmp"
  save_state
  if ss -lntp 2>/dev/null | grep -q '127\.0\.0\.1:443'; then ok 'Xray listener detected on 127.0.0.1:443.'; else warn 'Xray is not listening on 127.0.0.1:443 yet.'; fi
  ok "$FOREIGN_ROLE setup complete."
}

setup_menu(){
  header
  echo 'Choose this server role:'
  echo '  1) Iran controller / load balancer'
  echo '  2) Foreign A'
  echo '  3) Foreign B'
  echo '  0) Cancel'
  echo
  read -r -p 'Select: ' x
  case "$x" in
    1) setup_iran ;;
    2) setup_foreign a ;;
    3) setup_foreign b ;;
    0) return ;;
    *) warn 'Invalid selection.' ;;
  esac
}

health_iran(){
  echo '--- Data plane ---'
  if command -v dual-diagnose >/dev/null 2>&1; then dual-diagnose; else warn 'dual-diagnose not installed'; fi
  echo
  echo '--- Active user slots ---'
  if [[ -f "$HAPROXY_CFG" ]]; then
    local a b
    a="$(ss -Hnt 2>/dev/null | awk '$5 ~ /:15001$/ {n++} END{print n+0}')"
    b="$(ss -Hnt 2>/dev/null | awk '$5 ~ /:15002$/ {n++} END{print n+0}')"
    echo " Connections via slot A: $a"
    echo " Connections via slot B: $b"
    echo
    grep -A12 '^backend vpn_users' "$HAPROXY_CFG" || true
  fi
  echo
  echo '--- User sync ---'
  if command -v dual-usersync >/dev/null 2>&1; then
    systemctl is-active --quiet dual-user-sync.timer && ok 'user-sync timer active' || warn 'user-sync timer inactive'
    dual-usersync check 2>/dev/null || warn 'user-sync check failed'
  else
    echo ' Not configured yet.'
  fi
}

health_foreign(){
  if command -v dual-diagnose >/dev/null 2>&1; then dual-diagnose; else warn 'dual-diagnose not installed'; fi
  echo
  echo 'Control connections to Iran:'
  ss -ntp 2>/dev/null | grep -E "${IRAN_IP//./\.}:(3080|3081|3180|3181)|:443" || true
}

health(){
  header
  load_state || die 'Not configured.'
  [[ "$ROLE" == iran ]] && health_iran || health_foreign
}

backup_haproxy(){
  install -d -m 0700 "$BACKUP_DIR"
  [[ -f "$HAPROXY_CFG" ]] && cp -a "$HAPROXY_CFG" "$BACKUP_DIR/haproxy.panel.$(date +%Y%m%d-%H%M%S).cfg"
}

set_slot_disabled(){
  local slot="$1" mode="$2" needle
  [[ "$slot" == a ]] && needle='server foreign_a 127.0.0.1:15001' || needle='server foreign_b 127.0.0.1:15002'
  [[ -f "$HAPROXY_CFG" ]] || die 'HAProxy config missing.'
  backup_haproxy
  python3 - "$HAPROXY_CFG" "$needle" "$mode" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); needle=sys.argv[2]; mode=sys.argv[3]
lines=p.read_text().splitlines(); out=[]; found=False
for line in lines:
    if line.lstrip().startswith(needle):
        found=True
        parts=line.split()
        parts=[x for x in parts if x != 'disabled']
        line='    '+' '.join(parts)
        if mode == 'disable': line += ' disabled'
    out.append(line)
if not found: raise SystemExit('slot line not found')
p.write_text('\n'.join(out)+'\n')
PY
  haproxy -c -f "$HAPROXY_CFG" >/dev/null || die 'HAProxy validation failed. Restore from backup.'
  systemctl reload haproxy
  ok "Foreign ${slot^^} ${mode}d."
}

bundle_for_slot(){ [[ "$1" == a ]] && echo /root/dual-backhaul-foreign-a.env || echo /root/dual-backhaul-foreign-b.env; }
slot_ports(){ [[ "$1" == a ]] && echo '3080 3081' || echo '3180 3181'; }

replace_foreign_ip(){
  local slot="$1" old new bundle ports p label
  load_state || die 'Not configured.'
  [[ "$ROLE" == iran ]] || die 'Run IP replacement on Iran controller.'
  [[ "$slot" == a ]] && { old="$FOREIGN_A_IP"; label=A; } || { old="$FOREIGN_B_IP"; label=B; }
  header
  echo "Replace Foreign $label IP"
  echo " Current: $old"
  echo
  new="$(ask_ip "New Foreign $label IPv4")"
  [[ "$new" != "$old" ]] || { warn 'New IP equals current IP.'; return; }

  info "Draining Foreign $label first (new connections go to the other healthy slot)."
  set_slot_disabled "$slot" disable

  bundle="$(bundle_for_slot "$slot")"
  [[ -f "$bundle" ]] || die "Bundle missing: $bundle"
  cp -a "$bundle" "${bundle}.before-ip-change.$(date +%Y%m%d-%H%M%S)"
  sed -i "s/^FOREIGN_IP='[^']*'$/FOREIGN_IP='${new}'/" "$bundle"
  chmod 0600 "$bundle"
  if [[ "$slot" == a ]]; then FOREIGN_A_IP="$new"; else FOREIGN_B_IP="$new"; fi
  save_state

  ports="$(slot_ports "$slot")"
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    for p in $ports; do ufw allow from "$new" to any port "$p" proto tcp comment "Dual ${label} replacement" >/dev/null || true; done
  fi
  # Block the old Foreign from both WSS (:443) and this slot's direct control ports.
  if command -v iptables >/dev/null 2>&1; then
    for p in 443 $ports; do iptables -C INPUT -s "$old" -p tcp --dport "$p" -j REJECT 2>/dev/null || iptables -I INPUT 1 -s "$old" -p tcp --dport "$p" -j REJECT; done
  fi

  # The slot is drained, so safely restart its Iran-side Backhaul servers now.
  # This clears stale established control channels from the replaced Foreign.
  if [[ "$slot" == a ]]; then
    systemctl restart dual-bh-a-wss dual-bh-a-mux dual-bh-a-tcp
  else
    systemctl restart dual-bh-b-wss dual-bh-b-mux dual-bh-b-tcp
  fi

  echo
  ok "Foreign $label is drained; stale control sessions cleared; bundle updated: $bundle"
  echo
  read -r -p "Copy bundle to root@$new now with SCP? [Y/n]: " ans
  if [[ ! "${ans:-Y}" =~ ^[Nn]$ ]]; then
    scp "$bundle" "root@${new}:$(bundle_for_slot "$slot")" || warn 'SCP failed; copy the bundle manually.'
  fi
  echo
  echo "On the NEW Foreign $label run:"
  echo "  bash <(curl -fsSL ${RAW}/dual-control-panel/install.sh)"
  echo "Then choose Foreign $label."
  echo
  echo "After its health is green, return here and choose: Activate/Drain Foreign -> Activate $label"
  if [[ -f /etc/dual-user-sync/config.json ]] && grep -q "$old" /etc/dual-user-sync/config.json 2>/dev/null; then
    warn "User-sync configuration still references old IP $old. Reconfigure User Sync after X-UI is ready on $new."
  fi
  warn "Foreign $label remains DISABLED until you explicitly activate it."
}

activation_menu(){
  while :; do
    header
    echo 'Activate / Drain Foreign'
    echo '  1) Activate A'
    echo '  2) Drain A'
    echo '  3) Activate B'
    echo '  4) Drain B'
    echo '  0) Back'
    read -r -p 'Select: ' x
    case "$x" in 1) set_slot_disabled a enable; pause;; 2) set_slot_disabled a disable; pause;; 3) set_slot_disabled b enable; pause;; 4) set_slot_disabled b disable; pause;; 0) return;; esac
  done
}

foreign_deploy_help(){
  header
  load_state || die 'Not configured.'
  echo 'Foreign deployment bundles:'
  echo " A: /root/dual-backhaul-foreign-a.env -> root@${FOREIGN_A_IP}:/root/dual-backhaul-foreign-a.env"
  echo " B: /root/dual-backhaul-foreign-b.env -> root@${FOREIGN_B_IP}:/root/dual-backhaul-foreign-b.env"
  echo
  echo 'Copy commands:'
  echo " scp /root/dual-backhaul-foreign-a.env root@${FOREIGN_A_IP}:/root/dual-backhaul-foreign-a.env"
  echo " scp /root/dual-backhaul-foreign-b.env root@${FOREIGN_B_IP}:/root/dual-backhaul-foreign-b.env"
  echo
  echo 'Then on each Foreign run:'
  echo " bash <(curl -fsSL ${RAW}/dual-control-panel/install.sh)"
}

usersync_installed(){ command -v dual-usersync >/dev/null 2>&1; }
user_sync_menu(){
  [[ "$ROLE" == iran ]] || { warn 'The new design keeps user-sync on the Iran controller.'; pause; return; }
  while :; do
    header
    echo 'User Sync  (recommended: Foreign A -> Foreign B)'
    echo '  1) Setup / reconfigure panel URLs and credentials'
    echo '  2) Check differences'
    echo '  3) Sync now'
    echo '  4) Enable delete mirroring'
    echo '  5) Disable delete mirroring'
    echo '  6) Status'
    echo '  7) Logs'
    echo '  0) Back'
    read -r -p 'Select: ' x
    case "$x" in
      1) bash <(curl -fsSL "${ENGINE_RAW}/user-sync/install-user-sync.sh"); pause ;;
      2) usersync_installed && dual-usersync check || warn 'User-sync is not configured.'; pause ;;
      3) usersync_installed && dual-usersync sync || warn 'User-sync is not configured.'; pause ;;
      4) usersync_installed && dual-usersync enable-delete || warn 'User-sync is not configured.'; pause ;;
      5) usersync_installed && dual-usersync disable-delete || warn 'User-sync is not configured.'; pause ;;
      6) usersync_installed && dual-usersync status || warn 'User-sync is not configured.'; pause ;;
      7) usersync_installed && dual-usersync logs || warn 'User-sync is not configured.'; pause ;;
      0) return ;;
    esac
  done
}

restart_repair(){
  header
  load_state || die 'Not configured.'
  if [[ "$ROLE" == iran ]]; then
    echo 'Restarting Iran data-plane services...'
    systemctl restart dual-bh-a-wss dual-bh-a-mux dual-bh-a-tcp dual-bh-b-wss dual-bh-b-mux dual-bh-b-tcp haproxy
  else
    echo 'Restarting Foreign services...'
    systemctl restart dual-bh-health dual-bh-wss dual-bh-mux dual-bh-tcp
  fi
  sleep 2
  health
}

uninstall_panel(){
  header
  load_state || true
  echo -e "${c4}UNINSTALL DUAL PROJECT${c0}"
  echo 'This removes Dual services/configs created by this project. X-UI/Xray itself is NOT removed.'
  echo
  read -r -p 'Type UNINSTALL to continue: ' x
  [[ "$x" == UNINSTALL ]] || { warn 'Cancelled.'; return; }
  if [[ "${ROLE:-}" == iran ]]; then
    systemctl disable --now dual-bh-a-wss dual-bh-a-mux dual-bh-a-tcp dual-bh-b-wss dual-bh-b-mux dual-bh-b-tcp 2>/dev/null || true
    systemctl disable --now dual-user-sync.timer dual-user-sync.service 2>/dev/null || true
    rm -f /etc/systemd/system/dual-bh-a-{wss,mux,tcp}.service /etc/systemd/system/dual-bh-b-{wss,mux,tcp}.service
    rm -f /etc/systemd/system/dual-user-sync.{service,timer}
    rm -rf /etc/dual-user-sync /usr/local/lib/dual-user-sync
    rm -f /usr/local/bin/dual-usersync
    warn 'HAProxy is left installed. Restore/remove its config manually if this host has other HAProxy uses.'
  else
    systemctl disable --now dual-bh-health dual-bh-wss dual-bh-mux dual-bh-tcp 2>/dev/null || true
    rm -f /etc/systemd/system/dual-bh-health.service /etc/systemd/system/dual-bh-{wss,mux,tcp}.service
    rm -rf /opt/dual-backhaul-health
  fi
  rm -rf /etc/dual-backhaul /etc/dual-backhaul-ha "$STATE_DIR"
  rm -f /usr/local/bin/dual-diagnose /usr/local/bin/backhaul-dual
  systemctl daemon-reload
  ok 'Dual project files/services removed.'
  echo 'The dualctl command itself remains; remove it with: rm -f /usr/local/bin/dualctl'
}

show_topology(){
  header
  load_state || die 'Not configured.'
  if [[ "$ROLE" == iran ]]; then
    echo "Iran      : $IRAN_IP"
    echo "Foreign A : $FOREIGN_A_IP"
    echo "Foreign B : $FOREIGN_B_IP"
    echo "Domain A  : $DOMAIN_A"
    echo "Domain B  : $DOMAIN_B"
    echo
    echo 'Transport order per slot: WSSMux -> TCPMux -> plain TCP'
    echo 'Top-level routing: Active/Active + source-IP stickiness + health failover'
    echo 'User sync controller: Iran (when configured), A -> B'
  else
    echo "Role      : $FOREIGN_ROLE"
    echo "Iran      : $IRAN_IP"
    echo "Bundle    : $BUNDLE_PATH"
  fi
}

iran_menu(){
  while :; do
    header
    echo 'IRAN CONTROL PANEL'
    echo '  1) Dashboard / full health'
    echo '  2) Replace Foreign A IP'
    echo '  3) Replace Foreign B IP'
    echo '  4) Activate / Drain Foreign'
    echo '  5) User Sync'
    echo '  6) Foreign install / bundle help'
    echo '  7) Restart / repair data plane'
    echo '  8) Show topology'
    echo '  9) Uninstall Dual project'
    echo '  0) Exit'
    echo
    read -r -p 'Select: ' x
    case "$x" in
      1) health; pause;;
      2) replace_foreign_ip a; pause;;
      3) replace_foreign_ip b; pause;;
      4) activation_menu;;
      5) user_sync_menu;;
      6) foreign_deploy_help; pause;;
      7) restart_repair; pause;;
      8) show_topology; pause;;
      9) uninstall_panel; pause;;
      0) exit 0;;
    esac
  done
}

foreign_menu(){
  while :; do
    header
    echo 'FOREIGN CONTROL PANEL'
    echo '  1) Dashboard / health'
    echo '  2) Restart transports'
    echo '  3) Reinstall / repair from bundle'
    echo '  4) Check Xray listener'
    echo '  5) Show topology'
    echo '  6) Uninstall Dual project'
    echo '  0) Exit'
    echo
    read -r -p 'Select: ' x
    case "$x" in
      1) health; pause;;
      2) systemctl restart dual-bh-health dual-bh-wss dual-bh-mux dual-bh-tcp; health; pause;;
      3) [[ "$FOREIGN_ROLE" == foreign-a ]] && setup_foreign a || setup_foreign b; pause;;
      4) ss -lntp 2>/dev/null | grep '127.0.0.1:443' || warn 'Xray listener missing'; pause;;
      5) show_topology; pause;;
      6) uninstall_panel; pause;;
      0) exit 0;;
    esac
  done
}

main(){
  need_root; need curl; need python3
  case "${1:-}" in
    setup) setup_menu; return;;
    health|status) health; return;;
    replace-a) replace_foreign_ip a; return;;
    replace-b) replace_foreign_ip b; return;;
    users) load_state || die 'Not configured'; user_sync_menu; return;;
    uninstall) uninstall_panel; return;;
    version) echo "$VERSION"; return;;
    ''|menu) ;;
    *) echo 'Usage: dualctl [menu|setup|health|replace-a|replace-b|users|uninstall|version]'; exit 2;;
  esac
  if ! load_state; then setup_menu; return; fi
  [[ "$ROLE" == iran ]] && iran_menu || foreign_menu
}
main "$@"
